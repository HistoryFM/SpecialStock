# Required server-only values. Never prefix these with NEXT_PUBLIC_.
# Local development uses embedded PGlite and needs no database account.
LOCAL_DATABASE_PATH=.data/specialstock
AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
# Generate with: pnpm hash-password "your long password"
APP_PASSWORD_HASH=\$2b\$12\$replace-with-a-bcrypt-hash

# Add these values to enable real chart capture and Gemini analysis.
OPENROUTER_API_KEY=
CHART_IMG_API_KEY=
# Locked ULTRA layout for the full eight-study visual analysis chart.
CHART_IMG_WIDTH=1600
CHART_IMG_HEIGHT=1920
CHART_ARTIFACT_DIR=.data/chart-artifacts

# Optional: Alpaca remains the calendar and outcome-evaluation provider.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional future deployment value. Local PGlite ignores it.
DATABASE_URL=

# Sentry. Both DSN variables use the same project DSN; the NEXT_PUBLIC value is
# intentionally browser-visible so client errors and session replays can be sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: enables production source-map uploads during builds.
SENTRY_AUTH_TOKEN=
